<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="pause_title">Mika 일시 중지</string>
    <string name="pause_row_sub_active">다시 시작할 때까지 Mika의 모든 작업을 멈춰요</string>
    <string name="pause_row_sub_paused">일시 중지됨: 작업과 계획을 실행하지 않아요</string>
    <string name="pause_state_active">켜짐</string>
    <string name="pause_explain">일시 중지하면 실행 중이거나 대기 중인 작업이 모두 멈추고, 시간이 된 계획은 건너뛰며, 채팅·컴퓨터·메시지 채널에서 오는 새 작업은 다시 시작할 때까지 받지 않아요. 또 Mika의 접근성 서비스와 무선 디버깅을 끄고 휴대전화 도우미를 멈춰요. 아무것도 제거하거나 삭제하지 않으며, 무선 디버깅 페어링도 그대로 남아요.</string>
    <string name="pause_paused_title">Mika가 일시 중지됨</string>
    <string name="pause_paused_body">다시 시작할 때까지 작업은 실행되지 않고, 계획은 건너뛰며, 휴대전화 도우미는 멈춰 있어요.</string>
    <string name="pause_active_title">Mika가 켜져 있음</string>
    <string name="pause_active_body">Mika를 한동안 완전히 멈추고 싶을 때 일시 중지하세요.</string>
    <string name="pause_status_label">일시 중지하면 꺼지는 항목</string>
    <string name="pause_action">Mika 일시 중지</string>
